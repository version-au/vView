<Window x:Class="vView.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="vView" Width="1100" Height="720" MinWidth="480" MinHeight="320"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="{DynamicResource vx.Fg}" Background="Transparent"
        UseLayoutRounding="True" AllowDrop="True">

    <Window.Resources>
        <!-- a thumbnail in the strip along the bottom: the current one ringed in the accent -->
        <Style x:Key="vv.StripItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="Loaded" Handler="StripItem_Loaded"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Ring" Margin="3,0" Padding="2" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                            <Grid Width="84" Height="56">
                                <Border CornerRadius="4" Background="{DynamicResource vx.Panel}"/>
                                <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip><RectangleGeometry Rect="0,0,84,56" RadiusX="4" RadiusY="4"/></Image.Clip>
                                </Image>
                                <!-- a video or a sound: a small mark in the corner -->
                                <Border x:Name="Badge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                                        CornerRadius="3" Padding="4,1" Background="#B0000000">
                                    <TextBlock x:Name="BadgeGlyph" Text="&#xE768;" FontFamily="{StaticResource vx.Icons}" FontSize="9" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource vx.Hover}"/></Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource vx.Accent}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter TargetName="Badge" Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsAudio}" Value="True">
                                <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BadgeGlyph" Property="Text" Value="&#xE8D6;"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the big previous / next buttons at the sides of a picture -->
        <Style x:Key="vv.SideButton" TargetType="Button" BasedOn="{StaticResource vx.IconButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#55000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource vx.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Top bar: the menu, the file's name and place in the folder, the tools, the window's buttons ===== -->
        <DockPanel x:Name="TopBar" Grid.Row="0">
            <Button x:Name="AppMenuBtn" DockPanel.Dock="Left" Style="{StaticResource vx.IconButton}" Width="34" Height="30" Margin="6,0,4,0"
                    ToolTip="vView menu" Click="AppMenu_Click">
                <Image x:Name="AppMark" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <!-- a video from Jellyfin playing: back to Jellyfin's page -->
            <Button x:Name="JellyfinBtn" DockPanel.Dock="Left" Style="{StaticResource vx.IconButton}" Content="&#xE72B;" Visibility="Collapsed"
                    ToolTip="Back to Jellyfin (Esc)" Click="JellyfinBack_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource vx.CaptionButton}" Content="&#xE921;" ToolTip="Minimise" Click="Minimize_Click"/>
                <Button x:Name="MaxBtn" Style="{StaticResource vx.CaptionButton}" Content="&#xE922;" ToolTip="Maximise" Click="Maximize_Click"/>
                <Button Style="{StaticResource vx.CloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click"/>
            </StackPanel>
            <StackPanel x:Name="Tools" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <StackPanel x:Name="ZoomTools" Orientation="Horizontal">
                    <Button Style="{StaticResource vx.IconButton}" Content="&#xE71F;" ToolTip="Zoom out (-)" Click="ZoomOut_Click"/>
                    <Button x:Name="ZoomText" Style="{StaticResource vx.TextButton}" Background="Transparent" MinWidth="64" Margin="0" Padding="6,0"
                            ToolTip="Fit to the window / actual size (0 / 1)" Click="ZoomText_Click"/>
                    <Button Style="{StaticResource vx.IconButton}" Content="&#xE8A3;" ToolTip="Zoom in (+)" Click="ZoomIn_Click"/>
                    <Rectangle Style="{StaticResource vx.CommandSeparator}"/>
                    <Button Style="{StaticResource vx.IconButton}" Content="&#xE7AD;" ToolTip="Rotate left (Shift+R)" Click="RotateLeft_Click"/>
                    <Button Style="{StaticResource vx.IconButton}" Content="&#xE7AD;" ToolTip="Rotate right (R)" Click="RotateRight_Click" RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform><ScaleTransform ScaleX="-1"/></Button.RenderTransform>
                    </Button>
                    <Rectangle Style="{StaticResource vx.CommandSeparator}"/>
                </StackPanel>
                <Button x:Name="SlideBtn" Style="{StaticResource vx.IconButton}" Content="&#xE786;" ToolTip="Slideshow (F5)" Click="Slideshow_Click"/>
                <Button x:Name="FolderBtn" Style="{StaticResource vx.IconButton}" Content="&#xE838;" ToolTip="Show in its folder" Click="ShowInFolder_Click"/>
                <Button x:Name="DeleteBtn" Style="{StaticResource vx.IconButton}" Content="&#xE74D;" ToolTip="Move to the Recycle Bin (Delete)" Click="Delete_Click"/>
                <Button x:Name="DetailsBtn" Style="{StaticResource vx.IconButton}" Content="&#xE946;" ToolTip="Details (I)" Click="Details_Click"/>
                <!-- a song: into the classic player (a small window) -->
                <Button x:Name="ClassicBtn" Style="{StaticResource vx.IconButton}" Content="&#xE73F;" ToolTip="Classic player (a small window)" Click="Classic_Click" Visibility="Collapsed"/>
                <Button Style="{StaticResource vx.IconButton}" Content="&#xE740;" ToolTip="Full screen (F11)" Click="FullScreen_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                <TextBlock x:Name="NameText" Text="vView" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PlaceText" Margin="10,0,0,0" Foreground="{DynamicResource vx.FgDim}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== The picture / video, and the details beside it ===== -->
        <Grid Grid.Row="1" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailsCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="Stage" ClipToBounds="True" Background="Transparent" MouseWheel="Stage_MouseWheel"
                  MouseLeftButtonDown="Stage_MouseLeftButtonDown" MouseMove="Stage_MouseMove" MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                  MouseEnter="Stage_MouseEnter" MouseLeave="Stage_MouseLeave" SizeChanged="Stage_SizeChanged" MouseRightButtonUp="Stage_RightClick">
                <Canvas x:Name="PicCanvas">
                    <Image x:Name="Pic" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5"/>
                </Canvas>

                <!-- video (VLC draws into a window of its own here) -->
                <vlc:VideoView x:Name="Video" Visibility="Collapsed" Background="Black">
                    <!-- VLC's window takes the mouse: this see-through layer (LibVLCSharp shows it in a window over the video) catches the
                         right-click menu and the double-click for full screen -->
                    <Grid x:Name="VideoOverlay" Background="#01000000" MouseRightButtonUp="Stage_RightClick"
                          MouseLeftButtonDown="VideoOverlay_MouseLeftButtonDown" MouseWheel="VideoOverlay_MouseWheel"/>
                </vlc:VideoView>

                <!-- a sound: now playing (cover, title, artist, the visualiser) and the playlist beside it (MainWindow.Music.cs) -->
                <Grid x:Name="AudioCard" Visibility="Collapsed" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="PlaylistCol" Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="NowArea" SizeChanged="NowArea_SizeChanged">
                        <StackPanel x:Name="NowPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                            <Border x:Name="CoverBox" Width="300" Height="300" CornerRadius="14" Background="{DynamicResource vx.Panel}"
                                    BorderBrush="{DynamicResource vx.Line}" BorderThickness="1" HorizontalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="CoverGlyph" Text="&#xE8D6;" FontFamily="{StaticResource vx.Icons}" FontSize="72"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource vx.Accent}"/>
                                    <Border x:Name="CoverClip" CornerRadius="13" ClipToBounds="True">
                                        <Image x:Name="CoverImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="NowText" Margin="32,0,0,0" VerticalAlignment="Center" MaxWidth="520">
                                <TextBlock x:Name="NowLabel" Text="NOW PLAYING" FontSize="11" Foreground="{DynamicResource vx.FgDim}"/>
                                <TextBlock x:Name="AudioName" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AudioArtist" FontSize="15" Margin="0,6,0,0" Foreground="{DynamicResource vx.FgDim}" TextTrimming="CharacterEllipsis"/>
                                <ItemsControl x:Name="AudioFormat" Margin="0,12,0,0" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="8,2" Margin="0,0,6,6" Background="{DynamicResource vx.Ctrl}">
                                                <TextBlock Text="{Binding}" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- the visualiser: vView's own sound only (MainWindow.Spectrum.cs) -->
                                <Canvas x:Name="Spectrum" Margin="0,18,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- the playlist -->
                    <Border x:Name="PlaylistCard" Grid.Column="1" Style="{StaticResource vx.Card}" Margin="8,6,0,6" Padding="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="14,8,6,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource vx.IconButton}" Content="&#xE710;" ToolTip="Add songs" Click="AddSongs_Click"/>
                                    <Button Style="{StaticResource vx.IconButton}" Content="&#xE74E;" ToolTip="Save the list" Click="SavePlaylist_Click"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Playlist" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PlaylistSummary" FontSize="11.5" Foreground="{DynamicResource vx.FgDim}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="PlaylistList" Background="Transparent" BorderThickness="0" Margin="6,0,6,6" Padding="0"
                                     ItemContainerStyle="{DynamicResource vv.TrackItem}" AllowDrop="True" SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                     MouseDoubleClick="Playlist_DoubleClick" PreviewMouseLeftButtonDown="Playlist_PreviewMouseDown"
                                     PreviewMouseMove="Playlist_PreviewMouseMove" DragOver="Playlist_DragOver" Drop="Playlist_Drop"
                                     ContextMenuOpening="Playlist_ContextMenuOpening">
                                <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- nothing open yet (or the file can't be shown) -->
                <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyGlyph" Text="&#xE91B;" FontFamily="{StaticResource vx.Icons}" FontSize="56" HorizontalAlignment="Center" Foreground="{DynamicResource vx.FgDim}"/>
                    <TextBlock x:Name="EmptyText" Text="Open a media file, or drop one here" FontSize="14" Margin="0,16,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="EmptyOpen" Content="Open…" Style="{StaticResource vx.TextButton}" Click="Open_Click"/>
                        <Button Content="Open a folder…" Style="{StaticResource vx.TextButton}" Margin="8,0,0,0" Click="OpenFolder_Click"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="PrevBtn" Style="{StaticResource vv.SideButton}" Content="&#xE76B;" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="6,0,0,0" ToolTip="Previous (Left)" Click="Prev_Click"/>
                <Button x:Name="NextBtn" Style="{StaticResource vv.SideButton}" Content="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0" ToolTip="Next (Right)" Click="Next_Click"/>
            </Grid>

            <Border x:Name="DetailsCard" Grid.Column="1" Style="{StaticResource vx.Card}" Margin="8,0,0,0" Padding="16,14" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="DetName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetKind" Foreground="{DynamicResource vx.FgDim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <Border Height="1" Background="{DynamicResource vx.Line}" Margin="0,12"/>
                        <ItemsControl x:Name="DetProps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Key}" Width="84" Foreground="{DynamicResource vx.FgDim}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Copy path" Style="{StaticResource vx.TextButton}" Margin="0,0,6,6" Click="CopyPath_Click"/>
                            <Button Content="Open with…" Style="{StaticResource vx.TextButton}" Margin="0,0,6,6" Click="OpenWith_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Video and sound: play / pause, where it's up to, volume ===== -->
        <DockPanel x:Name="VideoBar" Grid.Row="2" Margin="10,6,10,0" Height="38" Visibility="Collapsed">
            <Button x:Name="BackMediaBtn" DockPanel.Dock="Left" Style="{StaticResource vx.IconButton}" Content="&#xE892;" ToolTip="Previous (Page Up)" Click="BackMedia_Click"/>
            <Button x:Name="PlayBtn" DockPanel.Dock="Left" Style="{StaticResource vx.IconButton}" Content="&#xE769;" ToolTip="Pause (Space)" Click="PlayPause_Click"/>
            <Button x:Name="NextMediaBtn" DockPanel.Dock="Left" Style="{StaticResource vx.IconButton}" Content="&#xE893;" ToolTip="Next (Page Down)" Click="NextMedia_Click"/>
            <TextBlock x:Name="TimeText" DockPanel.Dock="Left" Text="0:00" Margin="8,0,12,0" VerticalAlignment="Center" FontSize="12" MinWidth="40"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="LengthText" Text="0:00" Margin="12,0,10,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource vx.FgDim}"/>
                <Button x:Name="AudioBtn" Style="{StaticResource vx.IconButton}" Content="&#xE8D6;" ToolTip="Audio track" Click="AudioTracks_Click"/>
                <Button x:Name="SubsBtn" Style="{StaticResource vx.IconButton}" Content="&#xE7F0;" ToolTip="Subtitles" Click="Subtitles_Click"/>
                <Button x:Name="ShuffleBtn" Style="{StaticResource vx.IconButton}" Content="&#xE8B1;" ToolTip="Shuffle" Click="Shuffle_Click" Visibility="Collapsed"/>
                <Button x:Name="LoopBtn" Style="{StaticResource vx.IconButton}" Content="&#xE8EE;" ToolTip="Play again from the start" Click="Loop_Click"/>
                <Button x:Name="PlaylistBtn" Style="{StaticResource vx.IconButton}" Content="&#xE8FD;" ToolTip="Playlist" Click="PlaylistToggle_Click" Visibility="Collapsed"/>                <Button x:Name="MuteBtn" Style="{StaticResource vx.IconButton}" Content="&#xE767;" ToolTip="Mute (M)" Click="Mute_Click"/>
                <Grid x:Name="VolumeBar" Width="90" Height="24" Background="Transparent" Cursor="Hand" Margin="2,0,0,0" ToolTip="Volume (Up / Down)"
                      MouseLeftButtonDown="Bar_MouseDown" MouseMove="Bar_MouseMove" MouseLeftButtonUp="Bar_MouseUp">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource vx.Track}" VerticalAlignment="Center"/>
                    <Border x:Name="VolumeFill" Height="4" CornerRadius="2" Background="{DynamicResource vx.Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
            <Grid x:Name="SeekBar" Height="24" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="Bar_MouseDown" MouseMove="Bar_MouseMove" MouseLeftButtonUp="Bar_MouseUp">
                <Border Height="4" CornerRadius="2" Background="{DynamicResource vx.Track}" VerticalAlignment="Center"/>
                <Border x:Name="SeekFill" Height="4" CornerRadius="2" Background="{DynamicResource vx.Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Ellipse x:Name="SeekKnob" Width="12" Height="12" Fill="{DynamicResource vx.Fg}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </DockPanel>

        <!-- ===== The folder's pictures, videos and sounds ===== -->
        <ListBox x:Name="Strip" Grid.Row="3" Height="76" Margin="8,6,8,6" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource vv.StripItem}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                 PreviewMouseLeftButtonUp="Strip_Click" PreviewMouseWheel="Strip_MouseWheel" Focusable="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- ===== Jellyfin's page (MainWindow.Jellyfin.cs adds the browser over the note) ===== -->
        <Grid x:Name="JellyfinHost" Grid.Row="1" Grid.RowSpan="3" Margin="6,0,6,6" Visibility="Collapsed" Background="{DynamicResource vx.Bg}">
            <TextBlock x:Name="JellyfinNote" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="520" FontSize="14" Foreground="{DynamicResource vx.FgDim}"/>
        </Grid>
    </Grid>
</Window>
